# CMS Subfolder Configuration
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # If real file exists, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite extensionless CMS URLs (/cms/banners -> /cms/banners.php)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>
